# CampusShare - Student Resource Sharing Platform
# Environment Configuration

# Set your Firebase Web App credentials (from Firebase Console -> Project Settings -> General -> Your apps -> SDK setup and configuration)
# If left blank or untouched, CampusShare automatically operates in Demo Sandbox Mode with realistic WCE student data.

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional: Restrict registration to verified college email domains
VITE_COLLEGE_EMAIL_DOMAIN=walchandsangli.ac.in
